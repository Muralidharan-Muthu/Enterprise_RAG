# ── Supabase ──────────────────────────────────────────────────
SUPABASE_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.<your-project-ref>
SUPABASE_PASSWORD=<your-supabase-password>
SUPABASE_SCHEMA=multi_store_rag_working
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=rag-documents
DB_SSLMODE=require

# ── Groq LLM API ─────────────────────────────────────────────
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_SYNTHESIS_MODEL=openai/gpt-oss-120b
GROQ_EXTRACTION_MODEL=qwen/qwen3.6-27b
GROQ_SPYDER_MODEL=groq/compound
GROQ_RAVEN_MODEL=groq/compound-mini
GROQ_ENRICHMENT_MODEL=openai/gpt-oss-20b
GROQ_ROUTING_MODEL=groq/compound-mini
GROQ_CHAT_MODEL=groq/compound-mini
GROQ_TIMEOUT_SECONDS=120
GROQ_CONNECT_TIMEOUT_SECONDS=10
GROQ_MAX_RETRIES=6
GROQ_MIN_INTERVAL_SECONDS=2.0
GROQ_MAX_TOKENS=800
GROQ_MAX_CONCURRENT=3
INTENT_USE_LLM=true
HYDE_ENABLED=true

# ── BGE Embeddings + Reranker (downloaded locally on first run) ─
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5
RERANKER_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
# Prevent HuggingFace Hub from reaching out on every startup once models are cached.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── Agentic RAG / Hybrid / Retrieval Cache / Staged Ingestion ──
AGENTIC_RAG_ENABLED=true
HYBRID_IN_CLASSIC_PATH=true
RETRIEVAL_CACHE_ENABLED=true
INGESTION_STAGED_ENABLED=true

# ── Redis / Celery ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Neo4j Aura (Graph Store — entity-based multi-hop querying) ──
# For Neo4j Aura: URI format is neo4j+s://<instance-id>.databases.neo4j.io
# USERNAME and DATABASE are both the instance ID for Aura Free instances.
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=<your-instance-id>
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=<your-instance-id>
AURA_INSTANCEID=<your-instance-id>
AURA_INSTANCENAME=<your-instance-name>

# ── GraphRAG (entity-based documents + multi-hop querying) ──────
# Requires NEO4J_ENABLED=true and a reachable Neo4j instance.
GRAPHRAG_ENABLED=true
GRAPHRAG_EXTRACT_PER_CHUNK=true
GRAPHRAG_LOCAL_HOPS=2
GRAPHRAG_MAX_CHUNKS_PER_DOC=200
GRAPHRAG_EXTRACT_CONCURRENCY=4
GRAPHRAG_ENTITIES_PER_CHUNK=15
GRAPHRAG_LOCAL_TOP_ENTITIES=10
GRAPHRAG_GLOBAL_MAX_COMMUNITIES=8

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=["http://localhost:3000"]

# ── Chunking ──────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_CHUNK_SIZE_TOKENS=50

# ── Docling parsing ───────────────────────────────────────────
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_IMAGES_SCALE=2.0

# ── Frontend (Next.js public vars) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
